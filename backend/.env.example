# Copy to backend/.env and fill in. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# GLEIF and Wikidata company lookup work without keys.
# Optional SEC fallback for US companies: identify your app and real contact email.
# No SEC account or API key is needed. Leave unset to skip SEC.
# SEC_USER_AGENT=ASB Finstat your-email@example.com

# Optional: override the model for any AI call (see app/config.py for defaults)
# MODEL_COMPANY_SEARCH=openai/gpt-4o-mini
# MODEL_FIND_STATEMENTS=perplexity/sonar
# MODEL_LANGUAGE_CHECK=openai/gpt-4o-mini
# MODEL_TRANSLATE=google/gemini-2.5-flash
# MODEL_EXTRACT=anthropic/claude-sonnet-4.5

# Sophie's statement extractor: AI locates pages; source tables supply the values.
# EXTRACT_USE_LLM=true
# EXTRACT_OCR_MODE=auto
# EXTRACTION_DIR=data/extractions
# Tesseract on PATH is optional for text PDFs and required for scanned-page OCR.
